# Postgres connection string. Add ?sslmode=require for hosted Postgres (Neon, Supabase).
DATABASE_URL=
# At least 32 random characters; signs staff session cookies.
SESSION_SECRET=
# Shared secret Vercel Cron sends as a Bearer token.
CRON_SECRET=
# Optional: password for seeded demo staff accounts (defaults to estate-demo-2026).
DEMO_PASSWORD=
# Optional: confidence below this goes to the Unsorted lane (default 0.65).
AI_CONFIDENCE_THRESHOLD=
# Optional cloud model (any OpenAI-compatible API). Leave empty to use the local model only.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
